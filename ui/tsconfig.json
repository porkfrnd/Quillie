{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    // Strict mode is required by §3. These are not the defaults; they are the
    // settings that catch real bugs in a codebase where one side of the
    // boundary is Rust and the other is TypeScript.
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "useUnknownInCatchVariables": true,

    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",
    "paths": {
      "$lib/*": ["src/lib/*"],
      "$state/*": ["src/state/*"],
      "$render/*": ["src/render/*"],
      "$ipc/*": ["src/ipc/*"],
      "$motion/*": ["src/motion-eval/*"]
    },
    "types": ["vite/client", "svelte"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}